[Unit]
Description=Linko autonomous job collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linko
WorkingDirectory=/opt/linko
EnvironmentFile=/etc/linko.env
ExecStart=/opt/linko/.venv/bin/python -B /opt/linko/serve_service.py
Restart=on-failure
# Beklenmedik duruşlar (çökme, sinyal, zaman aşımı) olay klasörüne kaydedilir; '+' = root, normal durdurmada işlem yapmaz.
ExecStopPost=+/usr/local/bin/linko-spool-stop "$SERVICE_RESULT" "$EXIT_CODE" "$EXIT_STATUS"
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
