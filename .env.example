# =============================================================================
#  Linko Scrapper Light — Ortam Değişkenleri Şablonu
#  Kopyalayın: cp .env.example .env
#  Düzenleyin ve sunucuyu yeniden başlatın.
# =============================================================================

# --- Ağ Ayarları ---
# Sunucuda 0.0.0.0 (tüm arayüzler), geliştirmede 127.0.0.1 (sadece yerel)
JOBAPP_HOST=0.0.0.0
JOBAPP_PORT=8016

# --- Tarayıcı ---
# Sunucuda mutlaka 0 olmalı (masaüstü uygulaması değil)
JOBAPP_OPEN_BROWSER=0

# --- Arama sorgusu çevirisi ---
# Statik çok dilli eşanlamlılar her zaman çalışır. Google çevirisi varsayılan kapalı.
# 1 yapılırsa HTTP isteği çeviriyi bekleyebilir; hatalar 10 dakika önbelleklenir.
JOBAPP_TRANSLATE=0

# --- Tarama Ayarları ---
# İstekler arası bekleme süresi (saniye) — 10s varsayılanı; 429 etkisi canlı ölçümle doğrulanmalı
JOBAPP_REQUEST_INTERVAL=10.0
# Web ve CLI için ortak alt sınır
JOBAPP_MIN_REQUEST_INTERVAL=10.0
JOBAPP_REQUEST_JITTER=0.15
# Eşik tabanlı erken durma: yeni ilan oranı %20 altına inince aramayı tamamla
JOBAPP_LOW_YIELD_THRESHOLD=0.20
# Detay önbelleği: 72 saat (3 gün); kaldırılmış ilanlar: 5 dakika
JOBAPP_DETAIL_CACHE_TTL_SECONDS=259200
JOBAPP_DETAIL_MISSING_TTL_SECONDS=300
# Güvenlik kontrolünde en az 15 dakika ve açık erişim onayı
JOBAPP_ACCESS_PAUSE_SECONDS=900
# Bir saat içinde üç hız sınırı uyarısı açık onay gerektirir
JOBAPP_ACCESS_FAILURE_THRESHOLD=3
JOBAPP_ACCESS_FAILURE_WINDOW_SECONDS=3600
# Maksimum yeniden deneme sayısı
JOBAPP_MAX_RETRIES=10
# İlk soğuma süresi (saniye) — 2x katlanarak artar: 60→120→300
JOBAPP_RETRY_BASE_COOLDOWN=60.0

# --- Sınıflandırma Backend ---
# "rules"  = Tamamen offline, AI/API gerektirmez (ÖNERİLEN sunucu için)
# "claude" = Anthropic Claude API (ANTHROPIC_API_KEY gerektirir)
# "local"  = Yerel Ollama LLM (Ollama kurulu olmalı)
JOBAPP_CLASSIFY_BACKEND=rules

# --- Claude API (sadece classify_backend=claude ise) ---
# ANTHROPIC_API_KEY=sk-ant-api03-...
# JOBAPP_LLM_MODEL=claude-haiku-4-5

# --- Ollama (sadece classify_backend=local ise) ---
# JOBAPP_OLLAMA_HOST=http://localhost:11434
# JOBAPP_OLLAMA_MODEL=qwen3.5:9b
# JOBAPP_OLLAMA_EMBED_MODEL=qwen3-embedding:8b
# JOBAPP_OLLAMA_TIMEOUT_SECONDS=180

# --- Depolama ---
# Varsayılan: proje içinde jobapp/jobs.db
# JOBAPP_DB_PATH=/data/linko/jobs.db
# Varsayılan: proje içinde accountless_searches/
# JOBAPP_ACCOUNTLESS_OUTPUT_DIR=/data/linko/searches
